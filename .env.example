# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: live FX rate refresh. Free, no-key, ECB-backed.
EXCHANGE_RATE_API_BASE=https://api.frankfurter.app

# Optional: set to "false" to hide the Apple sign-in button until you've
# configured Apple as a provider in Supabase (Apple requires a paid dev account).
NEXT_PUBLIC_ENABLE_APPLE_SSO=true

# Optional: enables the full "Ask Orbis" AI assistant. Without a key, the
# assistant still answers common questions from your data via a built-in
# responder. Set either or both: OpenAI is tried first, Anthropic is the fallback.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5
# Only needed for personal / multi-workspace keys (starts with wrkspc_):
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
